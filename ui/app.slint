import { VerticalBox, HorizontalBox, Button, LineEdit, ListView, CheckBox, StandardTableView, Slider, TextEdit, ComboBox } from "std-widgets.slint";
import { TextureViewerWindow } from "texture_viewer.slint";
export { TextureViewerWindow } from "texture_viewer.slint";

export struct RouteItem {
    name: string,
    icon-source: image,
}

export struct ScenarioItem {
    name: string,
    scenario-type: string,
}

export struct IssueRowData {
    kind_text: string,
    missing_file: string,
    source_file: string,
    is_dead_resource: bool,
}

export struct BrokenResourceItem {
    id: int,
    kind_str: string,
    expected_path: string,
    parent_file: string,
    sources_count: int,
    is_dead: bool,
}

export component MainWindow inherits Window {
    title: "TSC Check Tool";
    min-width: 1350px;
    min-height: 1000px;

    in property <[RouteItem]> route-items: [];
    in-out property <bool> route-thumbnails-enabled: true;
    in-out property <bool> ignore-list-open: false;
    in property <[string]> ignored-routes: [];
    in property <[string]> incomplete-folders: [];
    in property <string> check-log: "";

    in property <float> check_progress: 0.0;
    in property <string> status: "";
    in-out property <string> search-query: "";
    in-out property <int> selected-route: -1;
    in property <bool> is-checking: false;
    in-out property <bool> show_log: false;
    in property <int> missing-assets-count: 0;
    in property <string> selected-route-name: "";
    in property <string> selected-route-id: "";
    in property <[ScenarioItem]> scenario-items: [];
    in-out property <int> selected-scenario: -1;
    in property <bool> has-result: false;

    callback route-selected(int);
    callback search-changed(string);
    callback start-check();
    callback reset-log();
    callback open-route-folder();
    callback show-inventory();
    callback open-folder-auditor();
    callback open-settings();
    callback scenario-selected(int);

    HorizontalLayout {
        // Left master: compact route list
        VerticalBox {
            preferred-width: 380px;
            min-width: 380px;
            max-width: 380px;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 6px;
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: @tr("Поиск маршрутов");
                    text <=> search-query;
                    edited(text) => {
                        root.search-changed(text);
                    }
                }
                 Button {
                     text: "⚙";
                     min-width: 32px;
                     clicked => { open-settings(); }
                 }
                 Button {
                     text: @tr("Проверка");
                     clicked => { open-folder-auditor(); }
                 }
            }
            ListView {
                vertical-stretch: 1;
                for item[i] in route-items: Rectangle {
                    min-height: 52px;
                    preferred-height: 56px;
                    background: i == selected-route ? #3a3a3a : transparent;
                    TouchArea {
                        clicked => {
                            selected-route = i;
                            route-selected(i);
                        }
                        double-clicked => {
                            open-route-folder();
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: LayoutAlignment.start;
                            padding: 4px;
                            Image {
                                source: item.icon-source;
                                width: route-thumbnails-enabled ? 64px : 0px;
                                height: route-thumbnails-enabled ? 40px : 0px;
                                preferred-width: route-thumbnails-enabled ? 64px : 0px;
                                preferred-height: route-thumbnails-enabled ? 40px : 0px;
                            }
                            Text {
                                text: item.name;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                wrap: TextWrap.no-wrap;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }
                }
            }
        }
        // Right detail
        VerticalBox {
            horizontal-stretch: 1;
            padding: 8px;
            spacing: 6px;
            if selected-route >= 0 : HorizontalLayout {
                spacing: 12px;
                alignment: LayoutAlignment.start;
                Rectangle {
                    width: 200px;
                    height: 100px;
                    horizontal-stretch: 0;
                    border-radius: 6px;
                    clip: true;
                    background: transparent;
                    Image {
                        source: route-items[selected-route].icon-source;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }
                VerticalBox {
                    horizontal-stretch: 1;
                    alignment: LayoutAlignment.center;
                    spacing: 4px;
                    Text {
                        text: selected-route-name;
                        font-size: 18px;
                        font-weight: 700;
                        wrap: TextWrap.no-wrap;
                        overflow: TextOverflow.elide;
                    }
                    Text {
                        text: "GUID: " + selected-route-id;
                        font-size: 12px;
                        color: #999999;
                        wrap: TextWrap.no-wrap;
                        overflow: TextOverflow.elide;
                    }
                    Text {
                        text: @tr("Сценариев: {}", scenario-items.length);
                        font-size: 13px;
                        color: #cccccc;
                    }
                }
            }
            Rectangle { height: 16px; }
            Text { text: @tr("Сценарии маршрута:"); font-size: 14px; }
            HorizontalBox {
                min-height: 32px;
                preferred-height: 32px;
                padding-top: 4px;
                Text {
                    text: @tr("Название сценария");
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("Тип");
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    width: 130px;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-height: 120px;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;
                ListView {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    for s[i] in scenario-items: Rectangle {
                    background: i == selected-scenario ? #3a3a3a : (Math.mod(i, 2) == 0 ? #1f1f1f : #262626);
                    TouchArea {
                        clicked => {
                            selected-scenario = i;
                        }
                        double-clicked => {
                            scenario-selected(i);
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: LayoutAlignment.stretch;
                            padding: 2px;
                            Text {
                                text: s.name;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                wrap: TextWrap.no-wrap;
                                overflow: TextOverflow.elide;
                            }
                            Text {
                                text: s.scenario-type;
                                font-size: 14px;
                                vertical-alignment: center;
                                width: 130px;
                                horizontal-alignment: TextHorizontalAlignment.right;
                                wrap: TextWrap.no-wrap;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }
                }
                }
            }
            HorizontalBox {
                min-height: 30px;
                preferred-height: 40px;
                Rectangle {
                    min-height: 30px;
                    preferred-height: 32px;
                    horizontal-stretch: 0;
                    border-radius: 4px;
                    background: route_check_touch.pressed ? #047857 : (route_check_touch.has-hover ? #10b981 : #059669);
                    route_check_touch := TouchArea {
                        enabled: selected-route >= 0;
                        clicked => { show_log = true; start-check(); }
                    }
                    Text {
                        text: @tr("Проверить маршрут");
                        color: #ffffff;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Button {
                    min-height: 30px;
                    text: @tr("Показать все объекты");
                    enabled: has-result;
                    clicked => { show-inventory(); }
                }
                Button {
                    min-height: 30px;
                    text: show_log ? @tr("Скрыть лог") : @tr("Показать лог");
                    clicked => { show_log = !show_log; }
                }
            }
            if show_log : Rectangle {
                height: 160px;
                width: 100%;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #1a1a1a;
                clip: true;
                VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        preferred-height: 24px;
                        min-height: 24px;
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: @tr("Лог");
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: #aaaaaa;
                        }
                    }
                    log_view := TextEdit {
                        text: check-log;
                        edited => { reset-log(); }
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                    }
                }
            }
            Text {
                text: status;
                font-size: 13px;
                color: missing-assets-count > 0 ? #ef4444 : #22c55e;
            }
        }
    }
}

export component AssetInventoryWindow inherits Window {
    title: @tr("Список объектов маршрута");
    min-width: 900px;
    min-height: 700px;

    in property <[ [StandardListViewItem] ]> inventory-rows;
    in property <[bool]> inventory-is-safe: [];
    in property <bool> show-missing-only: false;
    in-out property <string> search-query: "";
    in-out property <int> current-row: -1;
    in-out property <int> selected-asset: -1;

    callback toggle-missing-only();
    callback search-changed(string);
    callback row-selected(int);
    callback open-in-editor();
    callback replace-inventory-asset(int);
    callback scan-umlauts();
    callback sort-ascending(int);
    callback sort-descending(int);

    VerticalBox {
        HorizontalBox {
            LineEdit {
                placeholder-text: @tr("Поиск по пути, тайлу или исходному файлу");
                text <=> search-query;
                edited(text) => { root.search-changed(text); }
            }
            Button {
                text: show-missing-only ? @tr("Показать все") : @tr("Только недостающие");
                clicked => { toggle-missing-only(); }
            }
            Button {
                text: @tr("Открыть в редакторе");
                clicked => { root.open-in-editor(); }
            }
            Rectangle {
                property <bool> can_replace: selected-asset >= 0 && selected-asset < inventory-is-safe.length && inventory-is-safe[selected-asset];
                min-width: 190px;
                preferred-height: 32px;
                border-radius: 4px;
                background: !can_replace ? #262626 : (replace_touch.pressed ? #047857 : (replace_touch.has-hover ? #10b981 : #059669));

                replace_touch := TouchArea {
                    enabled: can_replace;
                    clicked => { root.replace-inventory-asset(selected-asset); }
                }

                Text {
                    text: @tr("Заменить в маршруте");
                    color: !can_replace ? #666666 : #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Button {
                text: @tr("Проверить на символы");
                clicked => { root.scan-umlauts(); }
            }
        }
        if selected-asset >= 0 && selected-asset < inventory-is-safe.length && !inventory-is-safe[selected-asset] : Text {
            text: @tr("⚠ Путевая инфраструктура заменяется только в редакторе TSC!!!");
            color: #f59e0b;
            font-size: 12px;
        }
        StandardTableView {
            current-row-changed(row) => {
                root.row-selected(row);
            }
            columns: [
                { title: @tr("Путь объекта"), min-width: 200px, horizontal-stretch: 2, sort-order: SortOrder.ascending },
                { title: @tr("Кол-во использований"), min-width: 120px, horizontal-stretch: 0 },
                { title: @tr("Тайлы"), min-width: 120px, horizontal-stretch: 1 },
            ];
            rows: inventory-rows;
            current-row <=> current-row;
            sort-ascending(col) => { root.sort-ascending(col); }
            sort-descending(col) => { root.sort-descending(col); }
        }
    }
}

export component IgnoreListWindow inherits Window {
    title: @tr("Игнор-лист маршрутов");
    min-width: 400px;
    min-height: 300px;

    in property <[string]> ignored-routes;

    VerticalBox {
        ListView {
            for r in ignored-routes: Text { text: r; }
        }
        Button { text: @tr("Добавить выбранный маршрут в игнор-лист"); }
    }
}

export component IncompleteFoldersWindow inherits Window {
    title: @tr("Сломанные маршруты");
    min-width: 500px;
    min-height: 300px;

    in property <[string]> folders;

    VerticalBox {
        ListView {
            for f in folders: Text { text: f; }
        }
    }
}

export component ScenarioWindow inherits Window {
    title: scenario-title;
    min-width: 1150px;
    min-height: 560px;

    in property <string> scenario-title: "";
    in property <string> scenario-name: "";
    in property <string> scenario-author: "";
    in property <string> scenario-season: "";
    in property <string> scenario-start-time: "";
    in property <string> scenario-weather: "";
    in property <[string]> consist-names: [];
    in property <[bool]> consist-player: [];
    accessible-role: AccessibleRole.none;
    in property <[bool]> consist-missing: [];
    in property <[bool]> consist-complete: [];
    in property <[string]> vehicle-names: [];
    in property <[bool]> vehicle-missing: [];
    in property <[string]> vehicle-paths: [];
    in property <string> selected-vehicle-path: "";
    in property <string> selected-vehicle-info: "";
    in property <image> selected-vehicle-image;

    in-out property <int> selected-consist: -1;
    in-out property <int> selected-vehicle: -1;

    callback consist-selected(int);
    callback open-locoswap();
    callback open-locoswap-consist(int);
    callback open-vehicle-path(int);
    callback vehicle-selected(int);
    callback open-selected-vehicle-path();
    callback open-scenario-folder();
    callback close-scenario();

    VerticalBox {
        padding: 8px;
        spacing: 8px;
        Rectangle {
            background: #1e1e1e;
            border-radius: 6px;
            VerticalBox {
                padding: 8px;
                spacing: 4px;
                Text { text: scenario-name; font-size: 16px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            Text { text: @tr("Время: {}", scenario-start-time); font-size: 12px; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            Text { text: @tr("Автор: {}", scenario-author); font-size: 12px; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            Text { text: @tr("Погода: {}", scenario-weather); font-size: 12px; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            Text { text: @tr("Сезон: {}", scenario-season); font-size: 12px; }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        HorizontalBox {
            spacing: 6px;
            vertical-stretch: 1;
            Rectangle {
                min-width: 295px;
                max-width: 295px;
                horizontal-stretch: 0;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;
                VerticalBox {
                    padding: 6px;
                    spacing: 4px;
                    Text { text: @tr("Составы ({})", consist-names.length); font-size: 14px; font-weight: 600; color: #cccccc; }
                    ListView {
                        vertical-stretch: 1;
                        for c[i] in consist-names: Rectangle {
                            background: i == selected-consist ? #3a3a3a : transparent;
                            TouchArea {
                                clicked => {
                                    selected-consist = i;
                                    consist-selected(i);
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: LayoutAlignment.start;
                                    padding: 2px;
                                    Text {
                                        text: "●";
                                        font-size: 10px;
                                        vertical-alignment: center;
                                        color: consist-complete[i] ? #10b981 : #ef4444;
                                    }
                                    if consist-player[i] : Rectangle {
                                        width: 42px;
                                        height: 16px;
                                        background: #1e3a5f;
                                        border-radius: 3px;
                                        Text {
                                            text: @tr("Игрок");
                                            color: #93c5fd;
                                            font-size: 10px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: c;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        color: #e5e5e5;
                                        horizontal-stretch: 1;
                                        wrap: TextWrap.no-wrap;
                                        overflow: TextOverflow.elide;
                                    }
                                    if consist-missing[i] : Button {
                                        text: @tr("LocoSwap");
                                        clicked => { open-locoswap-consist(i); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                min-width: 295px;
                max-width: 295px;
                horizontal-stretch: 0;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;
                VerticalBox {
                    padding: 6px;
                    spacing: 4px;
                    Text { text: @tr("Вагоны ({})", vehicle-names.length); font-size: 14px; font-weight: 600; color: #cccccc; }
                    ListView {
                        vertical-stretch: 1;
                        for v[i] in vehicle-names: Rectangle {
                            background: i == selected-vehicle ? #3a3a3a : transparent;
                            TouchArea {
                                clicked => {
                                    selected-vehicle = i;
                                    vehicle-selected(i);
                                }
                                double-clicked => { open-vehicle-path(i); }
                                HorizontalLayout {
                                    padding: 2px;
                                    Text {
                                        text: v;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        color: vehicle-missing[i] ? #ff6666 : #dddddd;
                                        horizontal-stretch: 1;
                                        wrap: TextWrap.no-wrap;
                                        overflow: TextOverflow.elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;
                VerticalLayout {
                    alignment: LayoutAlignment.start;
                    spacing: 6px;
                    padding: 6px;
                    Text { text: @tr("Свойства вагона"); font-size: 14px; font-weight: 600; color: #cccccc; }
                    Text {
                        text: selected-vehicle-info;
                        font-size: 12px;
                        wrap: TextWrap.word-wrap;
                        vertical-alignment: top;
                    }
                    TouchArea {
                        height: 18px;
                        double-clicked => { open-selected-vehicle-path(); }
                        HorizontalLayout {
                            alignment: LayoutAlignment.start;
                            padding: 0;
                            Text {
                                text: selected-vehicle-path;
                                font-size: 11px;
                                color: #4da3ff;
                                horizontal-alignment: TextHorizontalAlignment.left;
                                vertical-alignment: TextVerticalAlignment.center;
                                wrap: TextWrap.no-wrap;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }
                    if selected-vehicle-image.width > 0 : HorizontalLayout {
                        alignment: LayoutAlignment.start;
                        padding-top: 4px;
                        Rectangle {
                            width: 256px;
                            height: 128px;
                            border-radius: 4px;
                            clip: true;
                            background: #111111;
                            Image {
                                source: selected-vehicle-image;
                                width: 256px;
                                height: 128px;
                                image-fit: contain;
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }
        }
        HorizontalLayout {
            min-height: 36px;
            padding: 4px;
            Button {
                text: @tr("Открыть папку");
                clicked => { open-scenario-folder(); }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Rectangle {
                min-width: 200px;
                preferred-width: 200px;
                preferred-height: 32px;
                border-radius: 4px;
                background: locoswap_touch.pressed ? #047857 : (locoswap_touch.has-hover ? #10b981 : #059669);
                locoswap_touch := TouchArea {
                    clicked => { open-locoswap(); }
                }
                Text {
                    text: @tr("Открыть в LocoSwap");
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Button {
                text: @tr("Закрыть");
                clicked => { close-scenario(); }
            }
        }
    }
}
export component MissingAssetsWindow inherits Window {
    title: @tr("Недостающие объекты");
    min-width: 700px;
    min-height: 400px;

    in property <[string]> missing-assets: [];
    in property <[int]> missing-counts: [];
    in property <[string]> missing-suggested-repairs: [];
    in property <[bool]> missing-corrupted: [];
    in property <[string]> missing-asset-types: [];
    in property <[bool]> missing-is-safe: [];
    property <bool> has_selection: selected-asset >= 0;
    in-out property <bool> is_selected_asset_replaceable: has_selection && selected-asset < missing-is-safe.length && missing-is-safe[selected-asset];
    in-out property <[string]> active-tile-list: [];
    in property <string> active-tile-asset: "";
    in-out property <int> selected-asset: -1;
    callback replace-missing(int);
    callback repair-corrupted(int);
    callback repair-all-corrupted();
    callback copy-to-clipboard(string);
    callback copy-all-to-clipboard();
    callback close-missing();
    callback inspect-tiles(int);

    VerticalBox {
        padding: 6px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("Недостающие объекты маршрута");
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                background: #3b1d24;
                border-radius: 4px;
                min-width: 26px;
                height: 22px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: missing-assets.length;
                        color: #f87171;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            background: #181818;
            border-color: #333333;
            border-width: 1px;
            border-radius: 4px;
            clip: true;
            vertical-stretch: 1;
            ListView {
                for asset[i] in missing-assets: Rectangle {
                    background: i == selected-asset ? #2c2d30 : (row_touch.has-hover ? #222326 : transparent);
                    border-radius: 3px;

                    row_touch := TouchArea {
                        clicked => { selected-asset = i; }
                        double-clicked => { replace-missing(i); }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        padding-left: 8px;
                        padding-right: 6px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Text {
                            text: asset;
                            font-size: 12px;
                            color: #e2e8f0;
                            vertical-alignment: TextVerticalAlignment.center;
                            horizontal-alignment: TextHorizontalAlignment.left;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            overflow: TextOverflow.elide;
                        }

                        if missing-asset-types.length > i : Rectangle {
                            background: missing-asset-types[i] == @tr("Окружение") ? #1f3a2f : (missing-asset-types[i] == @tr("Лофт") ? #1f2f3a : (missing-asset-types[i] == @tr("Дорога") ? #2f1f3a : (missing-asset-types[i] == @tr("Путевая инфраструктура") ? #3a1f1f : (missing-asset-types[i] == @tr("Правила путей") ? #3a1f1f : #2a2a2a))));
                            border-radius: 3px;
                            height: 20px;
                            min-width: 70px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: missing-asset-types[i];
                                    color: #e2e8f0;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if missing-corrupted[i] : Rectangle {
                            background: #d97706;
                            border-radius: 3px;
                            height: 20px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: @tr("Повреждён путь");
                                    color: #ffffff;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            background: #25282e;
                            border-radius: 3px;
                            height: 22px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: missing-counts[i];
                                    font-size: 11px;
                                    color: #94a3b8;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if missing-corrupted[i] && missing-suggested-repairs[i] != "" : Text {
                            text: "-> / {missing-suggested-repairs[i]}";
                            font-size: 11px;
                            color: #fbbf24;
                            vertical-alignment: center;
                            overflow: TextOverflow.elide;
                        }

                        Button {
                            text: @tr("Копировать путь");
                            horizontal-stretch: 0;
                            min-width: 32px;
                            preferred-height: 24px;
                            clicked => { copy-to-clipboard(asset); }
                        }

                        if missing-corrupted[i] : Button {
                            text: @tr("Починить");
                            min-width: 70px;
                            preferred-height: 24px;
                            clicked => { repair-corrupted(i); }
                        }

                        Button {
                            text: @tr("Тайлы");
                            min-width: 60px;
                            preferred-height: 24px;
                            clicked => { inspect-tiles(i); }
                        }
                    }
                }
            }
        }
        if active-tile-list.length > 0 : Rectangle {
            background: #141414;
            border-color: #333333;
            border-width: 1px;
            border-radius: 4px;
            preferred-height: 140px;
            max-height: 160px;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                HorizontalLayout {
                    Text {
                        text: @tr("Использование на тайлах для: {}", active-tile-asset);
                        font-size: 12px;
                        font-weight: 700;
                        color: #cbd5e1;
                        horizontal-stretch: 1;
                        overflow: TextOverflow.elide;
                    }
                    Button {
                        text: @tr("✕ Закрыть");
                        preferred-height: 20px;
                        clicked => { active-tile-list = []; }
                    }
                }
                ListView {
                    for tile in active-tile-list: HorizontalLayout {
                        padding: 2px;
                        Text {
                            text: tile;
                            font-size: 11px;
                            color: #94a3b8;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: @tr("Копировать путь");
                            min-width: 28px;
                            preferred-height: 20px;
                            clicked => { copy-to-clipboard(tile); }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            min-height: 36px;
            padding: 4px;
            spacing: 6px;
            Button {
                text: @tr("Скопировать весь список");
                clicked => { copy-all-to-clipboard(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                min-width: 210px;
                preferred-width: 210px;
                preferred-height: 32px;
                border-radius: 4px;
                background: repair_all_touch.pressed ? #047857 : (repair_all_touch.has-hover ? #10b981 : #059669);
                repair_all_touch := TouchArea {
                    clicked => { repair-all-corrupted(); }
                }
                Text {
                    text: @tr("Починить все битые пути");
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                min-width: 190px;
                preferred-width: 190px;
                preferred-height: 32px;
                border-radius: 4px;
                background: (!root.has_selection || !root.is_selected_asset_replaceable) ? #262626 : (replace_touch.pressed ? #047857 : (replace_touch.has-hover ? #10b981 : #059669));

                replace_touch := TouchArea {
                    enabled: root.has_selection && root.is_selected_asset_replaceable;
                    clicked => {
                        if (root.has_selection && root.is_selected_asset_replaceable) {
                            replace-missing(selected-asset);
                        }
                    }
                }

                Text {
                    text: @tr("Заменить выбранный");
                    color: (!root.has_selection || !root.is_selected_asset_replaceable) ? #666666 : #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Button {
                text: @tr("Закрыть");
                clicked => { close-missing(); }
            }
        }
    }
}

export component ApAssetPickerWindow inherits Window {
    title: @tr("Выбор объекта из архива");
    min-width: 620px;
    min-height: 420px;

    in property <string> archive-name: "";
    in-out property <string> search-query: "";
    in property <[string]> entries: [];
    in property <[string]> filtered-entries: [];
    in-out property <int> selected-index: -1;
    in-out property <bool> extracting: false;

    callback search-changed(string);
    callback select-entry(int);
    callback confirm-selection();
    callback cancel();

    VerticalBox {
        padding: 6px;
        spacing: 6px;
        Text {
            text: @tr("Выбор объекта из архива: {}", archive-name);
            font-size: 16px;
            font-weight: 700;
        }
        LineEdit {
            placeholder-text: @tr("Поиск");
            text <=> search-query;
            edited => { search-changed(search-query); }
        }
        Rectangle {
            background: #181818;
            border-color: #333333;
            border-width: 1px;
            border-radius: 4px;
            clip: true;
            vertical-stretch: 1;
            ListView {
                for entry[i] in filtered-entries: Rectangle {
                    background: i == selected-index ? #2c2d30 : (row_touch.has-hover ? #222326 : transparent);
                    row_touch := TouchArea {
                        clicked => { select-entry(i); }
                        double-clicked => { select-entry(i); confirm-selection(); }
                        HorizontalLayout {
                            padding: 4px;
                            spacing: 6px;
                            Text {
                                text: entry;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            min-height: 36px;
            padding: 4px;
            spacing: 6px;
            Rectangle { horizontal-stretch: 1; }
            if root.extracting : Text {
                text: @tr("Извлечение...");
                color: #fbbf24;
                font-size: 12px;
                vertical-alignment: center;
            }
            Button {
                text: "Отмена";
                enabled: !root.extracting;
                clicked => { cancel(); }
            }
            Rectangle {
                min-width: 100px;
                preferred-width: 120px;
                preferred-height: 32px;
                border-radius: 4px;
                background: pick_touch.pressed ? #047857 : (pick_touch.has-hover ? #10b981 : #059669);
                pick_touch := TouchArea {
                    enabled: !root.extracting;
                    clicked => { confirm-selection(); }
                }
                Text {
                    text: @tr("Выбрать");
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: @tr("Настройки");
    min-width: 400px;
    min-height: 210px;

    in-out property <int> serz-process-limit: 8;
    in property <int> serz-process-limit-max: 16;
    in property <[string]> serz-presets: [];
    in-out property <int> serz-process-limit-index: 0;
    in-out property <string> locoswap-path: "";
    in-out property <string> game-path: "";
    max-height: 230px;
    max-width: 400px;
    preferred-height: 230px;
    preferred-width: 400px;
    in-out property <bool> route-thumbnails-enabled: true;
    in-out property <bool> route-scan-on-hdd: false;
    in-out property <bool> hide-quick-drive-free-roam: false;
    in-out property <[string]> language-options: ["ru", "en", "de"];
    in-out property <int> language-index: 0;

    callback save-settings();
    callback pick-locoswap();
    callback pick-game();
    callback serz-preset-selected(int);
    callback language-selected(string);

    VerticalBox {
        HorizontalBox {
            alignment: LayoutAlignment.start;
            cross-axis-alignment: CrossAxisAlignment.center;
            padding: 0px;
            Text { horizontal-alignment: TextHorizontalAlignment.start;
                min-width: 0px;
                overflow: TextOverflow.elide;
                text: @tr("Потоков процессора:");
                vertical-alignment: TextVerticalAlignment.center; }
            
            ComboBox {
                width: 100px;
                model: serz-presets;
                current-index <=> serz-process-limit-index;
                selected(text) => {
                    root.serz-preset-selected(self.current-index)
                }
            }
        }
        HorizontalBox {
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.center;
            min-height: 20px;
            padding: 0px;
            spacing: 8px;
            Text { horizontal-alignment: TextHorizontalAlignment.start;
                line-height-factor: 0;
                min-height: 20px;
                overflow: TextOverflow.elide;
                text: @tr("Путь к LocoSwap:");
                vertical-alignment: TextVerticalAlignment.center;
                wrap: TextWrap.word-wrap; }
            LineEdit {
                font-family: "";
                font-italic: false;
                font-size: 0px;
                horizontal-alignment: TextHorizontalAlignment.left;
                min-height: 20px; text <=> locoswap-path; }
            Button { icon-size: 15px;
                min-height: 20px;
                text: @tr("Обзор"); clicked => { pick-locoswap(); } }
        }
        HorizontalBox {
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.center;
            min-height: 20px;
            padding: 0px;
            spacing: 8px;
            Text { horizontal-alignment: TextHorizontalAlignment.start;
                line-height-factor: 0;
                min-height: 20px;
                overflow: TextOverflow.elide;
                text: @tr("Папка с игрой:");
                vertical-alignment: TextVerticalAlignment.center;
                wrap: TextWrap.word-wrap; }
            LineEdit {
                font-family: "";
                font-italic: false;
                font-size: 0px;
                horizontal-alignment: TextHorizontalAlignment.left;
                min-height: 20px; text <=> game-path; }
            Button { icon-size: 15px;
                min-height: 20px;
                text: @tr("Обзор"); clicked => { pick-game(); } }
        }
        CheckBox {
            min-height: 20px;
            text: @tr("Миниатюры маршрутов");
            checked <=> route-thumbnails-enabled;
        }
        CheckBox {
            min-height: 20px;
            text: @tr("Игра установлена на HDD");
            checked <=> route-scan-on-hdd;
        }
        CheckBox {
            min-height: 20px;
            text: @tr("Не отображать Quick-Drive и Free-Roam сценарии");
            checked <=> hide-quick-drive-free-roam;
        }
        HorizontalBox {
            alignment: LayoutAlignment.start;
            cross-axis-alignment: CrossAxisAlignment.center;
            padding: 0px;
            Text {
                horizontal-alignment: TextHorizontalAlignment.start;
                min-width: 0px;
                overflow: TextOverflow.elide;
                text: @tr("Язык интерфейса:");
                vertical-alignment: TextVerticalAlignment.center;
            }
            ComboBox {
                width: 100px;
                model: language-options;
                current-index <=> language-index;
                selected(text) => {
                    root.language-selected(text)
                }
            }
        }
        Button {
            min-height: 20px;
            text: @tr("Сохранить");
            clicked => { save-settings(); }
        }
    }
}

component FilterBadge inherits Rectangle {
    in property <int> count: 0;
    in property <bool> is_active: false;

    background: is_active ? #047857 : #374151;
    border-radius: 9px;
    height: 18px;
    min-width: 18px;
    horizontal-stretch: 0;

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        alignment: center;

        Text {
            text: root.count;
            font-size: 11px;
            font-weight: 600;
            color: #f3f4f6;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component FilterTabButton inherits Rectangle {
    in property <string> text;
    in property <int> count: 0;
    in property <bool> active: false;
    callback clicked();

    background: active ? #10b981 : #252932;
    border-radius: 6px;
    height: 32px;
    horizontal-stretch: 1;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? #ffffff : #d1d5db;
            vertical-alignment: center;
        }

        FilterBadge {
            count: root.count;
            is_active: root.active;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component ColumnSplitter inherits Rectangle {
    callback moved(length);
    width: 8px;
    background: transparent;

    Rectangle {
        x: 3px;
        width: 2px;
        background: #2e3440;
    }

    TouchArea {
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.moved(self.mouse-x - self.pressed-x);
            }
        }
    }
}

export component FolderAuditorWindow inherits Window {
    title: @tr("Проверка ресурсов папки");
    min-width: 900px;
    min-height: 620px;

    in-out property <string> folder-path: "";
    in-out property <string> current-filter: "all";
    in-out property <int> selected-row-index: -1;

    in-out property <bool> is-selected-texture: false;
    in-out property <bool> has-missing-file-selected: false;
    in-out property <string> incoming-refs-preview: "";
    in-out property <string> outgoing-refs-preview: "";

    // Resizable column widths
    in-out property <length> col-kind-width: 140px;
    in-out property <length> col-missing-width: 380px;
    in-out property <int> sort-col: 2;
    in-out property <bool> sort-ascending: true;
    in property <float> scan-progress: 0.0;
    in property <string> scan-status-text: @tr("Готов к проверке");
    in-out property <bool> is-scanning: false;
    in-out property <bool> is-scan-completed: false;
    in property <string> editor-status: "";
    in property <[BrokenResourceItem]> filtered-rows: [];

    in-out property <int> count-all: 0;
    in-out property <int> count-geometry: 0;
    in-out property <int> count-textures: 0;
    in-out property <int> count-scripts: 0;
    in-out property <int> count-sounds: 0;
    in-out property <int> count-children: 0;
    in-out property <int> count-dead: 0;

    in-out property <int> summer-candidate-count: 0;
    in-out property <string> summer-candidate-size-text: "";
    in-out property <bool> is-consolidating: false;
    in-out property <bool> show-summer-dialog: false;

    callback pick-folder();
    callback start-audit(string);
    callback filter-changed(string);
    callback row-selected(int);
    callback open-source-file(int);
    callback open-missing-target-folder(int);
    callback edit-in-vscode(int);
    callback preview-texture(int);
    callback sort-column(int);
    callback show-graph-clicked();
    callback open-full-graph();
    callback open-global-graph();
    callback open-summer-dialog();
    callback close-summer-dialog();
    callback confirm-consolidate-summer();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        HorizontalBox {
            spacing: 8px;
            path_input := LineEdit {
                horizontal-stretch: 1;
                text <=> folder-path;
                placeholder-text: @tr("Папка для проверки...");
                enabled: !root.is-scanning;
            }
            Button {
                text: @tr("Обзор");
                enabled: !root.is-scanning;
                clicked => { root.pick-folder(); }
            }
            Button {
                text: root.is-scanning ? @tr("Проверка...") : @tr("Начать проверку");
                primary: true;
                enabled: !root.is-scanning && path_input.text != "";
                clicked => { root.start-audit(root.folder-path); }
            }
        }

        VerticalBox {
            spacing: 4px;
            padding: 0px;
            vertical-stretch: 0;
            if root.is-scanning : Rectangle {
                height: 4px;
                background: #333333;
                Rectangle {
                    x: 0px;
                    width: max(0px, root.scan-progress * parent.width);
                    height: 100%;
                    background: #3b82f6;
                }
            }
            Text {
                text: root.scan-status-text;
                font-size: 12px;
                color: root.is-scanning ? #60a5fa : #9ca3af;
            }
        }

        if !root.is-scanning && root.is-scan-completed : HorizontalBox {
            spacing: 6px;
            padding: 0px;
            vertical-stretch: 0;

            if root.count-all > 0 : HorizontalLayout {
                spacing: 6px;
                FilterTabButton {
                    text: @tr("Всё");
                    count: root.count-all;
                    active: root.current-filter == "all";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "all";
                        root.filter-changed("all");
                    }
                }

                if root.count-geometry > 0 : FilterTabButton {
                    text: @tr("Геометрия");
                    count: root.count-geometry;
                    active: root.current-filter == "geometry";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "geometry";
                        root.filter-changed("geometry");
                    }
                }

                if root.count-textures > 0 : FilterTabButton {
                    text: @tr("Текстуры");
                    count: root.count-textures;
                    active: root.current-filter == "texture";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "texture";
                        root.filter-changed("texture");
                    }
                }

                if root.count-scripts > 0 : FilterTabButton {
                    text: @tr("Скрипты");
                    count: root.count-scripts;
                    active: root.current-filter == "script";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "script";
                        root.filter-changed("script");
                    }
                }

                if root.count-sounds > 0 : FilterTabButton {
                    text: @tr("Звуки");
                    count: root.count-sounds;
                    active: root.current-filter == "sound";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "sound";
                        root.filter-changed("sound");
                    }
                }

                if root.count-children > 0 : FilterTabButton {
                    text: @tr("Дочерние объекты");
                    count: root.count-children;
                    active: root.current-filter == "child";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "child";
                        root.filter-changed("child");
                    }
                }

                if root.count-dead > 0 : FilterTabButton {
                    text: @tr("Мёртвые ресурсы");
                    count: root.count-dead;
                    active: root.current-filter == "orphans";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "orphans";
                        root.filter-changed("orphans");
                    }
                }
            }

            if root.count-all == 0 : Rectangle {
                width: 8px;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: @tr("Полный граф каталога");
                    enabled: !root.is-scanning && root.is-scan-completed;
                    clicked => { root.open-full-graph(); }
                    min-width: 170px;
                    preferred-height: 32px;
                }
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 0px;

            Text {
                text: sort-col == 0 ? (sort-ascending ? @tr("Тип ↑") : @tr("Тип ↓")) : @tr("Тип");
                width: root.col-kind-width;
                horizontal-alignment: left;
                vertical-alignment: center;
                color: #9ca3af;
                font-size: 12px;
                TouchArea { clicked => { root.sort-column(0); } }
            }

            ColumnSplitter {
                moved(delta) => {
                    root.col-kind-width = max(80px, root.col-kind-width + delta);
                }
            }

            if root.current-filter != "orphans" : HorizontalLayout {
                spacing: 0px;
                Text {
                    text: sort-col == 1 ? (sort-ascending ? @tr("Отсутствующий файл ↑") : @tr("Отсутствующий файл ↓")) : @tr("Отсутствующий файл");
                    width: root.col-missing-width;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    color: #9ca3af;
                    font-size: 12px;
                    TouchArea { clicked => { root.sort-column(1); } }
                }

                ColumnSplitter {
                    moved(delta) => {
                        root.col-missing-width = max(120px, root.col-missing-width + delta);
                    }
                }
            }

            Text {
                text: root.current-filter == "orphans" ? (sort-col == 2 ? (sort-ascending ? @tr("Неиспользуемый файл на диске ↑") : @tr("Неиспользуемый файл на диске ↓")) : @tr("Неиспользуемый файл на диске")) : (sort-col == 2 ? (sort-ascending ? @tr("Файл-источник ↑") : @tr("Файл-источник ↓")) : @tr("Файл-источник"));
                horizontal-alignment: left;
                vertical-alignment: center;
                horizontal-stretch: 1;
                color: #9ca3af;
                font-size: 12px;
                TouchArea { clicked => { root.sort-column(2); } }
            }
        }

        Rectangle {
            background: #181b20;
            border-radius: 6px;
            border-width: 1px;
            border-color: #282c34;
            vertical-stretch: 1;

            if root.filtered-rows.length == 0 : VerticalBox {
                alignment: center;
                Text {
                    text: @tr("Проблем не обнаружено");
                    color: #6b7280;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }

            ListView {
                for item[idx] in root.filtered-rows : Rectangle {
                    background: idx == root.selected-row-index ? #2b313c : (Math.mod(idx, 2) == 0 ? #181b20 : #1c2026);
                    height: 28px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 0px;

                        Text {
                            text: item.kind_str;
                            width: root.col-kind-width;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            color: item.is_dead ? #eab308 : #ef4444;
                            overflow: elide;
                        }

                        Rectangle { width: 8px; background: transparent; }

                        if root.current-filter != "orphans" : HorizontalLayout {
                            spacing: 0px;
                            Text {
                                text: item.expected_path;
                                width: root.col-missing-width;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                color: #f3f4f6;
                                overflow: elide;
                            }
                            Rectangle { width: 8px; background: transparent; }
                        }

                        Text {
                            text: item.parent_file;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: item.is_dead ? #f3f4f6 : #9ca3af;
                            overflow: elide;
                        }
                    }

                    TouchArea {
                        clicked => { root.selected-row-index = idx; root.row-selected(idx); }
                    }
                }
            }
        }

        if root.selected-row-index >= 0 : VerticalBox {
            padding: 0px;
            spacing: 8px;

            HorizontalBox {
                padding: 0px;
                spacing: 16px;
                Text {
                    text: @tr("Входящие ссылки: ") + root.incoming-refs-preview;
                    font-size: 11px;
                    color: #9ca3af;
                    overflow: elide;
                }
                Text {
                    text: @tr("Исходящие ссылки: ") + root.outgoing-refs-preview;
                    font-size: 11px;
                    color: #9ca3af;
                    overflow: elide;
                }
            }

            HorizontalBox {
                padding: 0px;
                spacing: 8px;

                Button {
                    text: @tr("Открыть папку файла-источника");
                    enabled: !root.is-scanning;
                    clicked => { root.open-source-file(root.selected-row-index); }
                }
                Button {
                    text: @tr("Открыть файл-источник");
                    enabled: !root.is-scanning;
                    clicked => { root.edit-in-vscode(root.selected-row-index); }
                }
                if root.has-missing-file-selected : Button {
                    text: @tr("Открыть папку отсутствующего файла");
                    enabled: !root.is-scanning;
                    clicked => { root.open-missing-target-folder(root.selected-row-index); }
                }
                if root.is-selected-texture : Button {
                    text: @tr("Просмотр текстуры");
                    enabled: !root.is-scanning;
                    clicked => { root.preview-texture(root.selected-row-index); }
                }
                Button {
                    text: @tr("Граф связей");
                    enabled: !root.is-scanning;
                    clicked => { root.show-graph-clicked(); }
                }
            }
        }

        Text { text: root.editor-status; color: #a1a1aa; font-size: 12px; }
    }

    if show-summer-dialog: Rectangle {
        background: #000000a0;

        TouchArea {}

        Rectangle {
            width: 850px;
            height: 520px;
            background: #1f1f1f;
            border-color: #383838;
            border-width: 1px;
            border-radius: 8px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    Text {
                        text: "Консолидация летних текстур";
                        font-size: 16px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                    Text {
                        text: "(" + summer-candidate-count + " шт., " + summer-candidate-size-text + ")";
                        font-size: 14px;
                        color: #00a86b;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Летние варианты (_Su) будут скопированы поверх базовых текстур, а сами файлы _Su удалены. В игре графика останется прежней.";
                    font-size: 12px;
                    color: #a0a0a0;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 28px;
                    background: #282828;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text { width: 220px; text: "Удаляемый файл (_Su)"; font-size: 12px; font-weight: 600; color: #cccccc; vertical-alignment: center; }
                        Text { width: 180px; text: "Базовая текстура"; font-size: 12px; font-weight: 600; color: #cccccc; vertical-alignment: center; }
                        Text { width: 90px; text: "Размер"; font-size: 12px; font-weight: 600; color: #cccccc; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Папка"; font-size: 12px; font-weight: 600; color: #cccccc; vertical-alignment: center; }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    Button {
                        text: "Отмена";
                        clicked => { root.close-summer-dialog(); }
                    }

                    Button {
                        text: "Применить и удалить дубликаты";
                        primary: true;
                        enabled: !is-consolidating;
                        clicked => { root.confirm-consolidate-summer(); }
                    }
                }
            }
        }
    }
}
