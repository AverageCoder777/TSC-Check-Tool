import {
    VerticalBox,
    HorizontalBox,
    Button,
    LineEdit,
    ListView,
    CheckBox,
    StandardTableView,
    Slider,
    TextEdit,
    ComboBox,
} from "std-widgets.slint";
import { TextureViewerWindow } from "texture_viewer.slint";
export { TextureViewerWindow } from "texture_viewer.slint";
import { GeoViewerWindow } from "geo_viewer.slint";
export { GeoViewerWindow } from "geo_viewer.slint";

export struct RouteItem {
    name: string,
    icon-source: image,
}

export struct ScenarioItem {
    name: string,
    scenario-type: string,
}

export struct IssueRowData {
    kind_text: string,
    missing_file: string,
    source_file: string,
    is_dead_resource: bool,
}

export struct BrokenResourceItem {
    id: int,
    kind_str: string,
    expected_path: string,
    parent_file: string,
    sources_count: int,
    is_dead: bool,
}

export struct LogLine {
    text: string,
    color: color,
}

export component MainWindow inherits Window {
    title: "TSC Check Tool";
    min-width: 1350px;
    min-height: 1000px;

    in property <[RouteItem]> route-items: [];
    in-out property <bool> route-thumbnails-enabled: true;
    in-out property <bool> ignore-list-open: false;
    in property <[string]> ignored-routes: [];
    in property <[string]> incomplete-folders: [];
    in-out property <bool> show-incomplete-warning: false;
    in property <[LogLine]> log-lines: [];

    in property <float> check_progress: 0.0;
    in property <string> status: "";
    in-out property <string> search-query: "";
    in-out property <int> selected-route: -1;
    in property <bool> is-checking: false;
    in-out property <bool> show_log: false;
    in property <int> missing-assets-count: 0;
    in property <string> selected-route-name: "";
    in property <string> selected-route-id: "";
    in property <[ScenarioItem]> scenario-items: [];
    in-out property <int> selected-scenario: -1;
    in property <bool> has-result: false;

    callback route-selected(int);
    callback search-changed(string);
    callback start-check();
    callback reset-log();
    callback open-route-folder();
    callback show-inventory();
    callback open-folder-auditor();
    callback open-settings();
    callback scenario-selected(int);
    callback copy-guid(string);
    callback dismiss-incomplete-warning-once();
    callback dismiss-incomplete-warning-forever();
    callback show-incomplete-folders-list();

    HorizontalLayout {
        VerticalBox {
            preferred-width: 380px;
            min-width: 380px;
            max-width: 380px;
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: 6px;

                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: @tr("Searching routes");
                    text <=> search-query;
                    edited(text) => {
                        root.search-changed(text);
                    }
                }

                if search-query != "": Text {
                    text: @tr("{} {}", route-items.length, @tr("found"));
                    font-size: 12px;
                    color: #999999;
                    vertical-alignment: center;
                }

                Button {
                    text: "⚙";
                    min-width: 32px;
                    clicked => { open-settings(); }
                }

                Button {
                    text: @tr("Asset check");
                    clicked => { open-folder-auditor(); }
                }
            }

            ListView {
                vertical-stretch: 1;
                for item[i] in route-items: Rectangle {
                    min-height: 52px;
                    preferred-height: 56px;
                    background: i == selected-route ? #3a3a3a : transparent;

                    TouchArea {
                        clicked => {
                            selected-route = i;
                            route-selected(i);
                        }
                        double-clicked => {
                            open-route-folder();
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: LayoutAlignment.start;
                            padding: 4px;

                            Image {
                                source: item.icon-source;
                                width: route-thumbnails-enabled ? 64px : 0px;
                                height: route-thumbnails-enabled ? 40px : 0px;
                                preferred-width: route-thumbnails-enabled ? 64px : 0px;
                                preferred-height: route-thumbnails-enabled ? 40px : 0px;
                            }

                            Text {
                                text: item.name;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }
                }
            }
        }

        VerticalBox {
            horizontal-stretch: 1;
            padding: 8px;
            spacing: 6px;
            if selected-route >= 0: HorizontalLayout {
                spacing: 12px;
                alignment: LayoutAlignment.start;

                Rectangle {
                    width: 200px;
                    height: 100px;
                    horizontal-stretch: 0;
                    border-radius: 6px;
                    clip: true;

                    Image {
                        source: route-items[selected-route].icon-source;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }

                VerticalBox {
                    horizontal-stretch: 1;
                    alignment: LayoutAlignment.center;
                    spacing: 4px;

                    Text {
                        text: selected-route-name;
                        font-size: 18px;
                        font-weight: 700;
                        overflow: TextOverflow.elide;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: LayoutAlignment.start;

                        Text {
                            text: "GUID: " + selected-route-id;
                            font-size: 12px;
                            color: #999999;
                            overflow: TextOverflow.elide;
                        }

                        if selected-route-id != "": Rectangle {
                            min-width: 20px;
                            preferred-height: 20px;
                            border-radius: 4px;
                            background: copy_guid_touch.pressed ? #3a3a3a : (copy_guid_touch.has-hover ? #2a2a2a : transparent);

                            copy_guid_touch := TouchArea {
                                clicked => { root.copy-guid(selected-route-id); }
                            }

                            Text {
                                text: "📋";
                                font-size: 12px;
                                color: #cccccc;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: @tr("Scenarios: {}", scenario-items.length);
                        font-size: 13px;
                        color: #cccccc;
                    }
                }
            }
            Rectangle {
                height: 16px;
            }

            Text {
                text: @tr("Route scenarios:");
                font-size: 14px;
            }

            if scenario-items.length > 0 && selected-route >= 0: HorizontalBox {
                min-height: 32px;
                preferred-height: 32px;
                padding-top: 4px;

                Text {
                    text: @tr("Scenario name");
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: @tr("Type");
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    width: 130px;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-height: 120px;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;

                if scenario-items.length == 0 || selected-route < 0: VerticalBox {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: @tr("This route has no scenarios");
                        color: #a0a0a0;
                        font-size: 15px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: @tr("No scenarios were found in Scenarios folder of selected route.");
                        color: #707070;
                        font-size: 12px;
                        wrap: TextWrap.word-wrap;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                if scenario-items.length > 0 && selected-route >= 0: ListView {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    for s[i] in scenario-items: Rectangle {
                        background: i == selected-scenario ? #3a3a3a : (Math.mod(i, 2) == 0 ? #1f1f1f : #262626);

                        TouchArea {
                            clicked => {
                                selected-scenario = i;
                            }
                            double-clicked => {
                                scenario-selected(i);
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                padding: 2px;

                                Text {
                                    text: s.name;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    overflow: TextOverflow.elide;
                                }

                                Text {
                                    text: s.scenario-type;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    width: 130px;
                                    horizontal-alignment: TextHorizontalAlignment.right;
                                    overflow: TextOverflow.elide;
                                }
                            }
                        }
                    }
                }
            }

            HorizontalBox {
                min-height: 30px;
                preferred-height: 40px;

                Rectangle {
                    min-height: 30px;
                    preferred-height: 32px;
                    horizontal-stretch: 0;
                    border-radius: 4px;
                    background: route_check_touch.pressed ? #047857 : (route_check_touch.has-hover ? #10b981 : #059669);

                    route_check_touch := TouchArea {
                        enabled: selected-route >= 0;
                        clicked => { show_log = true; start-check(); }
                    }

                    Text {
                        text: @tr("Check route");
                        color: #ffffff;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    min-height: 30px;
                    preferred-height: 32px;
                    border-radius: 4px;
                    background: !has-result ? #232324 : (show_inv_touch.pressed ? #4a4a4d : (show_inv_touch.has-hover ? #3a3a3a : #2a2a2a));
                    opacity: !has-result ? 0.45 : 1.0;

                    show_inv_touch := TouchArea {
                        enabled: has-result;
                        clicked => { show-inventory(); }
                    }

                    Text {
                        text: @tr("Show all assets");
                        color: !has-result ? #6e6e6e : #ffffff;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Button {
                    min-height: 30px;
                    text: show_log ? @tr("Hide log") : @tr("Show log");
                    clicked => { show_log = !show_log; }
                }
            }

            if show_log: Rectangle {
                height: 160px;
                width: 100%;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #1a1a1a;
                clip: true;

                VerticalLayout {
                    spacing: 0px;

                    HorizontalLayout {
                        preferred-height: 24px;
                        min-height: 24px;
                        padding-left: 8px;
                        padding-right: 8px;

                        Text {
                            text: @tr("Log");
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: #aaaaaa;
                        }
                    }

                    ListView {
                        for line[i] in log-lines: Text {
                            text: line.text;
                            font-size: 13px;
                            color: line.color;
                            wrap: TextWrap.word-wrap;
                        }
                    }
                }
            }
            Text {
                text: status;
                font-size: 13px;
                color: missing-assets-count > 0 ? #ef4444 : #22c55e;
            }
        }
    }

    if show-incomplete-warning: Rectangle {
        background: #000000a0;

        TouchArea { }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 460px;
                    background: #1f1f1f;
                    border-color: #383838;
                    border-width: 1px;
                    border-radius: 8px;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000080;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "⚠";
                                font-size: 20px;
                                color: #f59e0b;
                                vertical-alignment: center;
                            }

                            Text {
                                text: @tr("Corrupted folders found ({})", incomplete-folders.length);
                                font-size: 16px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: @tr("Incomplete route folders were found in the Content/Routes folder. These folders will not be shown as routes. You can ignore this warning, disable it permanently, or view the list.");
                            font-size: 13px;
                            color: #cccccc;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            Button {
                                text: @tr("Ignore");
                                clicked => { root.dismiss-incomplete-warning-once(); }
                            }

                            Button {
                                text: @tr("Don't show anymore");
                                clicked => { root.dismiss-incomplete-warning-forever(); }
                            }

                            Button {
                                text: @tr("Show list");
                                primary: true;
                                clicked => { root.show-incomplete-folders-list(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AssetInventoryWindow inherits Window {
    title: @tr("Route assets list");
    min-width: 900px;
    min-height: 700px;

    in property <[ [StandardListViewItem] ]> inventory-rows;
    in property <[bool]> inventory-is-safe: [];
    in property <[bool]> inventory-can-delete: [];
    in property <bool> show-missing-only: false;
    in-out property <string> search-query: "";
    in-out property <int> current-row: -1;
    in-out property <int> selected-asset: -1;

    callback toggle-missing-only();
    callback search-changed(string);
    callback row-selected(int);
    callback open-in-editor();
    callback replace-inventory-asset(int);
    callback delete-inventory-asset(int);
    callback scan-umlauts();
    callback sort-ascending(int);
    callback sort-descending(int);

    VerticalBox {
        HorizontalBox {
            LineEdit {
                placeholder-text: @tr("Search by path, tile, or source file");
                text <=> search-query;
                edited(text) => { root.search-changed(text); }
            }

            Button {
                text: show-missing-only ? @tr("Show all") : @tr("Only missing");
                clicked => { toggle-missing-only(); }
            }

            Button {
                text: @tr("Open in editor");
                clicked => { root.open-in-editor(); }
            }

            Rectangle {
                property <bool> can_replace: selected-asset >= 0 && selected-asset < inventory-is-safe.length && inventory-is-safe[selected-asset];
                min-width: 190px;
                preferred-height: 32px;
                border-radius: 4px;
                background: !can_replace ? #262626 : (replace_touch.pressed ? #047857 : (replace_touch.has-hover ? #10b981 : #059669));

                replace_touch := TouchArea {
                    enabled: can_replace;
                    clicked => { root.replace-inventory-asset(selected-asset); }
                }

                Text {
                    text: @tr("Replace in route");
                    color: !can_replace ? #666666 : #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                property <bool> can_delete: selected-asset >= 0 && selected-asset < inventory-can-delete.length && inventory-can-delete[selected-asset];
                min-width: 170px;
                preferred-height: 32px;
                border-radius: 4px;
                background: !can_delete ? #262626 : (delete_touch.pressed ? #991b1b : (delete_touch.has-hover ? #dc2626 : #991b1b));

                delete_touch := TouchArea {
                    enabled: can_delete;
                    clicked => { root.delete-inventory-asset(selected-asset); }
                }

                Text {
                    text: @tr("Delete from route");
                    color: !can_delete ? #666666 : #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Button {
                text: @tr("Check for symbols");
                clicked => { root.scan-umlauts(); }
            }
        }

        if selected-asset >= 0 && selected-asset < inventory-is-safe.length && !inventory-is-safe[selected-asset]: Text {
            text: @tr("⚠ Track infrastructure can be replaced only in the TSC editor!!!");
            color: #f59e0b;
            font-size: 12px;
        }
        StandardTableView {
            current-row-changed(row) => {
                root.row-selected(row);
            }
            columns: [
                {
                    title: @tr("Asset path"),
                    min-width: 200px,
                    horizontal-stretch: 2,
                    sort-order: SortOrder.ascending
                },
                { title: @tr("Uses count"), min-width: 120px, horizontal-stretch: 0 },
                { title: @tr("Tiles"), min-width: 120px, horizontal-stretch: 1 },
            ];
            rows: inventory-rows;
            current-row <=> current-row;
            sort-ascending(col) => { root.sort-ascending(col); }
            sort-descending(col) => { root.sort-descending(col); }
        }
    }
}

export component IgnoreListWindow inherits Window {
    title: @tr("Ignore-list of routes");
    min-width: 400px;
    min-height: 300px;

    in property <[string]> ignored-routes;

    VerticalBox {
        ListView {
            for r in ignored-routes: Text {
                text: r;
            }
        }

        Button {
            text: @tr("Add selected to ignore-list");
        }
    }
}

export struct IncompleteFolderItem {
    folder_name: string,
    full_path: string,
    missing_criteria: string,
    file_count: int,
    size_mb: string,
}

export component IncompleteFoldersWindow inherits Window {
    title: @tr("Incomplete and corrupted routes");
    min-width: 850px;
    min-height: 520px;

    in property <[IncompleteFolderItem]> folders;
    in-out property <int> selected-index: -1;

    in property <string> summary: "";

    callback open-in-explorer(string);
    callback delete-selected(int);
    callback delete-all();
    callback close-window();

    VerticalBox {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: @tr("Incomplete and corrupted routes");
                font-size: 18px;
                font-weight: 700;
                color: #ffffff;
                vertical-alignment: center;
            }

            Rectangle {
                background: #3b1d24;
                border-radius: 4px;
                min-width: 32px;
                height: 22px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;

                    Text {
                        text: folders.length;
                        color: #f87171;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: summary;
                font-size: 12px;
                color: #9ca3af;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #181b20;
            border-color: #333333;
            border-width: 1px;
            border-radius: 6px;
            clip: true;

            if folders.length == 0: VerticalBox {
                alignment: center;

                Text {
                    text: @tr("No incomplete folders found");
                    color: #6b7280;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }

            ListView {
                for item[i] in folders: Rectangle {
                    min-height: 78px;
                    preferred-height: 86px;
                    background: i == selected-index ? #2c2d30 : (row_touch.has-hover ? #252932 : transparent);
                    border-color: i == selected-index ? #10b981 : (row_touch.has-hover ? #3d4452 : #2a2e37);
                    border-width: 1px;
                    border-radius: 6px;

                    row_touch := TouchArea {
                        clicked => { selected-index = i; }
                        double-clicked => { root.open-in-explorer(item.full_path); }
                    }

                    HorizontalLayout {
                        padding: 8px;
                        spacing: 10px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: item.folder_name;
                                font-size: 14px;
                                font-weight: 700;
                                color: #e5e5e5;
                                overflow: TextOverflow.elide;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: @tr("{} files", item.file_count);
                                    font-size: 11px;
                                    color: #94a3b8;
                                }

                                Text {
                                    text: item.size_mb;
                                    font-size: 11px;
                                    color: #94a3b8;
                                }
                            }

                            Text {
                                text: @tr("Missing: ") + item.missing_criteria;
                                font-size: 12px;
                                color: #fca5a5;
                                wrap: TextWrap.word-wrap;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: center;

                            Rectangle {
                                min-width: 96px;
                                preferred-height: 26px;
                                border-radius: 4px;
                                border-color: #3d4452;
                                border-width: 1px;
                                background: explorer_touch.pressed ? #333742 : (explorer_touch.has-hover ? #323640 : #2a2e37);

                                explorer_touch := TouchArea {
                                    clicked => { root.open-in-explorer(item.full_path); }
                                }

                                Text {
                                    text: @tr("📁 explorer");
                                    color: #e5e5e5;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            min-height: 36px;
            padding: 4px;
            spacing: 6px;

            Rectangle {
                min-width: 150px;
                preferred-height: 32px;
                border-radius: 4px;
                background: (selected-index < 0) ? #262626 : (delete_selected_touch.pressed ? #7f1d1d : (delete_selected_touch.has-hover ? #991b1b : #dc2626));

                delete_selected_touch := TouchArea {
                    enabled: selected-index >= 0;
                    clicked => {
                        if (selected-index >= 0) {
                            root.delete-selected(selected-index);
                        }
                    }
                }

                Text {
                    text: @tr("Delete selected");
                    color: (selected-index < 0) ? #666666 : #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                min-width: 130px;
                preferred-height: 32px;
                border-radius: 4px;
                background: (folders.length == 0) ? #262626 : (delete_all_touch.pressed ? #7f1d1d : (delete_all_touch.has-hover ? #991b1b : #dc2626));

                delete_all_touch := TouchArea {
                    enabled: folders.length > 0;
                    clicked => { root.delete-all(); }
                }

                Text {
                    text: @tr("Delete all");
                    color: (folders.length == 0) ? #666666 : #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: @tr("Close");
                clicked => { root.close-window(); }
            }
        }
    }
}

export component ScenarioWindow inherits Window {
    title: scenario-title;
    min-width: 1150px;
    min-height: 560px;

    in property <string> scenario-title: "";
    in property <string> scenario-name: "";
    in property <string> scenario-author: "";
    in property <string> scenario-season: "";
    in property <string> scenario-start-time: "";
    in property <string> scenario-weather: "";
    in property <[string]> consist-names: [];
    in property <[bool]> consist-player: [];
    accessible-role: AccessibleRole.none;
    in property <[bool]> consist-missing: [];
    in property <[bool]> consist-complete: [];
    in property <[string]> vehicle-names: [];
    in property <[bool]> vehicle-missing: [];
    in property <[string]> vehicle-paths: [];
    in property <string> selected-vehicle-path: "";
    in property <string> selected-vehicle-info: "";
    in property <image> selected-vehicle-image;

    in-out property <int> selected-consist: -1;
    in-out property <int> selected-vehicle: -1;

    callback consist-selected(int);
    callback open-locoswap();
    callback open-locoswap-consist(int);
    callback open-vehicle-path(int);
    callback vehicle-selected(int);
    callback open-selected-vehicle-path();
    callback open-scenario-folder();
    callback close-scenario();

    VerticalBox {
        padding: 8px;
        spacing: 8px;

        Rectangle {
            background: #1e1e1e;
            border-radius: 6px;

            VerticalBox {
                padding: 8px;
                spacing: 4px;

                Text {
                    text: scenario-name;
                    font-size: 16px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;

                            Text {
                                text: @tr("Time: {}", scenario-start-time);
                                font-size: 12px;
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;

                            Text {
                                text: @tr("Author: {}", scenario-author);
                                font-size: 12px;
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;

                            Text {
                                text: @tr("Weather: {}", scenario-weather);
                                font-size: 12px;
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;

                            Text {
                                text: @tr("Season: {}", scenario-season);
                                font-size: 12px;
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        HorizontalBox {
            spacing: 6px;
            vertical-stretch: 1;

            Rectangle {
                min-width: 295px;
                max-width: 295px;
                horizontal-stretch: 0;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;

                VerticalBox {
                    padding: 6px;
                    spacing: 4px;

                    Text {
                        text: @tr("Consists ({})", consist-names.length);
                        font-size: 14px;
                        font-weight: 600;
                        color: #cccccc;
                    }

                    ListView {
                        vertical-stretch: 1;
                        for c[i] in consist-names: Rectangle {
                            background: i == selected-consist ? #3a3a3a : transparent;

                            TouchArea {
                                clicked => {
                                    selected-consist = i;
                                    consist-selected(i);
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: LayoutAlignment.start;
                                    padding: 2px;

                                    Text {
                                        text: "●";
                                        font-size: 10px;
                                        vertical-alignment: center;
                                        color: consist-complete[i] ? #10b981 : #ef4444;
                                    }

                                    if consist-player[i]: Rectangle {
                                        width: 42px;
                                        height: 16px;
                                        background: #1e3a5f;
                                        border-radius: 3px;

                                        Text {
                                            text: @tr("Player");
                                            color: #93c5fd;
                                            font-size: 10px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: c;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        color: #e5e5e5;
                                        horizontal-stretch: 1;
                                        overflow: TextOverflow.elide;
                                    }

                                    if consist-missing[i]: Button {
                                        text: "LocoSwap";
                                        clicked => { open-locoswap-consist(i); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                min-width: 295px;
                max-width: 295px;
                horizontal-stretch: 0;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;

                VerticalBox {
                    padding: 6px;
                    spacing: 4px;

                    Text {
                        text: @tr("Wagons ({})", vehicle-names.length);
                        font-size: 14px;
                        font-weight: 600;
                        color: #cccccc;
                    }

                    ListView {
                        vertical-stretch: 1;
                        for v[i] in vehicle-names: Rectangle {
                            background: i == selected-vehicle ? #3a3a3a : transparent;

                            TouchArea {
                                clicked => {
                                    selected-vehicle = i;
                                    vehicle-selected(i);
                                }
                                double-clicked => { open-vehicle-path(i); }

                                HorizontalLayout {
                                    padding: 2px;

                                    Text {
                                        text: v;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        color: vehicle-missing[i] ? #ff6666 : #dddddd;
                                        horizontal-stretch: 1;
                                        overflow: TextOverflow.elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;

                VerticalLayout {
                    alignment: LayoutAlignment.start;
                    spacing: 6px;
                    padding: 6px;

                    Text {
                        text: @tr("Wagon properties");
                        font-size: 14px;
                        font-weight: 600;
                        color: #cccccc;
                    }

                    Text {
                        text: selected-vehicle-info;
                        font-size: 12px;
                        wrap: TextWrap.word-wrap;
                    }

                    TouchArea {
                        height: 18px;
                        double-clicked => { open-selected-vehicle-path(); }

                        HorizontalLayout {
                            alignment: LayoutAlignment.start;
                            padding: 0;

                            Text {
                                text: selected-vehicle-path;
                                font-size: 11px;
                                color: #4da3ff;
                                horizontal-alignment: TextHorizontalAlignment.left;
                                vertical-alignment: TextVerticalAlignment.center;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }

                    if selected-vehicle-image.width > 0: HorizontalLayout {
                        alignment: LayoutAlignment.start;
                        padding-top: 4px;

                        Rectangle {
                            width: 256px;
                            height: 128px;
                            border-radius: 4px;
                            clip: true;
                            background: #111111;

                            Image {
                                source: selected-vehicle-image;
                                width: 256px;
                                height: 128px;
                                image-fit: contain;
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }
        }

        HorizontalLayout {
            min-height: 36px;
            padding: 4px;

            Button {
                text: @tr("Open folder");
                clicked => { open-scenario-folder(); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Rectangle {
                min-width: 200px;
                preferred-width: 200px;
                preferred-height: 32px;
                border-radius: 4px;
                background: locoswap_touch.pressed ? #047857 : (locoswap_touch.has-hover ? #10b981 : #059669);

                locoswap_touch := TouchArea {
                    clicked => { open-locoswap(); }
                }

                Text {
                    text: @tr("Open in LocoSwap");
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Button {
                text: @tr("Close");
                clicked => { close-scenario(); }
            }
        }
    }
}

export struct TileEntry {
    label: string,
    file_path: string,
}

export component MissingAssetsWindow inherits Window {
    title: @tr("Missing objects");
    min-width: 700px;
    min-height: 400px;

    in property <[string]> missing-assets: [];
    in property <[int]> missing-counts: [];
    in property <[string]> missing-suggested-repairs: [];
    in property <[bool]> missing-corrupted: [];
    in property <[string]> missing-asset-types: [];
    in property <[bool]> missing-is-safe: [];
    in property <[string]> missing-asset-dirs: [];
    in property <[string]> missing-asset-files: [];
    in property <bool> can-repair-all: false;
    property <bool> has_selection: selected-asset >= 0;
    in-out property <bool> is_selected_asset_replaceable: has_selection && selected-asset < missing-is-safe.length && missing-is-safe[selected-asset];
    property <bool> can_delete_selected: has_selection && selected-asset < missing-asset-types.length && (missing-asset-types[selected-asset] == "Scenery" || missing-asset-types[selected-asset] == "Loft");
    in-out property <string> missing-search-query: "";
    in-out property <[TileEntry]> active-tile-list: [];
    in property <string> active-tile-asset: "";
    in-out property <int> selected-asset: -1;
    callback replace-missing(int);
    callback repair-corrupted(int);
    callback repair-all-corrupted();
    callback copy-to-clipboard(string);
    callback copy-all-to-clipboard();
    callback close-missing();
    callback inspect-tiles(int);
    callback delete-from-route(int);
    callback search-changed(string);

    VerticalBox {
        padding: 6px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: @tr("Missing objects");
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }

            search_input := LineEdit {
                placeholder-text: @tr("Search by path or file");
                width: 260px;
                text <=> missing-search-query;
                edited(text) => { root.search-changed(text); }
            }

            Rectangle {
                background: #3b1d24;
                border-radius: 4px;
                min-width: 32px;
                height: 22px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;

                    Text {
                        text: missing-assets.length;
                        color: #f87171;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        Rectangle {
            vertical-stretch: 1;

            ListView {
                for asset[i] in missing-assets: Rectangle {
                    background: i == selected-asset ? #2c2d30 : (row_touch.has-hover ? #222326 : transparent);
                    border-radius: 3px;

                    row_touch := TouchArea {
                        clicked => { selected-asset = i; root.inspect-tiles(i); }
                        double-clicked => { replace-missing(i); }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        HorizontalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;

                            Text {
                                text: missing-asset-dirs[i];
                                font-size: 12px;
                                color: #94a3b8;
                                vertical-alignment: TextVerticalAlignment.center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                overflow: TextOverflow.elide;
                            }

                            Text {
                                text: missing-asset-files[i];
                                font-size: 12px;
                                font-weight: 600;
                                color: #f1f5f9;
                                vertical-alignment: TextVerticalAlignment.center;
                                min-width: 0px;
                                overflow: TextOverflow.elide;
                            }
                        }

                        if missing-asset-types.length > i: Rectangle {
                            background: missing-asset-types[i] == @tr("Scenery") ? #1f3a2f : (missing-asset-types[i] == @tr("Loft") ? #1f2f3a : (missing-asset-types[i] == @tr("Road") ? #2f1f3a : (missing-asset-types[i] == @tr("Track infrastructure") ? #3a1f1f : (missing-asset-types[i] == @tr("Track rules") ? #3a1f1f : #2a2a2a))));
                            border-radius: 3px;
                            height: 20px;
                            min-width: 70px;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;

                                Text {
                                    text: missing-asset-types[i];
                                    color: #e2e8f0;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if missing-corrupted[i]: Rectangle {
                            background: #d97706;
                            border-radius: 3px;
                            height: 20px;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;

                                Text {
                                    text: @tr("Path corrupted");
                                    color: #ffffff;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            background: #25282e;
                            border-radius: 3px;
                            height: 22px;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;

                                Text {
                                    text: missing-counts[i];
                                    font-size: 11px;
                                    color: #94a3b8;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if missing-corrupted[i] && missing-suggested-repairs[i] != "": Text {
                            text: "-> / {missing-suggested-repairs[i]}";
                            font-size: 11px;
                            color: #fbbf24;
                            vertical-alignment: center;
                            overflow: TextOverflow.elide;
                        }

                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #334155;
                            background: copy_touch.has-hover ? #3b4252 : #262930;

                            copy_touch := TouchArea {
                                clicked => { copy-to-clipboard(asset); }
                            }

                            Rectangle {
                                x: 4px;
                                y: 4px;
                                width: 16px;
                                height: 16px;
                                border-width: 1.5px;
                                border-color: copy_touch.has-hover ? #ffffff : #94a3b8;
                            }

                            Rectangle {
                                x: 8px;
                                y: 8px;
                                width: 16px;
                                height: 16px;
                                border-width: 1.5px;
                                border-color: copy_touch.has-hover ? #ffffff : #94a3b8;
                            }
                        }
                    }
                }
            }
        }

        if active-tile-list.length > 0: Rectangle {
            height: 1px;
            background: #334155;
            horizontal-stretch: 1;
        }

        if active-tile-list.length > 0: Rectangle {
            background: #181a20;
            border-color: #333333;
            border-width: 1px;
            border-radius: 4px;
            clip: true;

            VerticalLayout {
                padding: 6px;
                spacing: 4px;

                HorizontalLayout {
                    Text {
                        text: @tr("Used on tiles for: {}", active-tile-asset);
                        font-size: 12px;
                        font-weight: 700;
                        color: #cbd5e1;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        overflow: TextOverflow.elide;
                    }

                    Button {
                        text: "X";
                        preferred-height: 20px;
                        max-height: 20px;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        clicked => { active-tile-list = []; }
                    }
                }

                Rectangle {
                    max-height: 110px;
                    clip: true;

                    ListView {
                        vertical-stretch: 1;
                        for tile in active-tile-list: HorizontalLayout {
                            padding: 2px;

                            Text {
                                text: tile.label;
                                font-size: 13px;
                                color: #94a3b8;
                                horizontal-stretch: 1;
                                overflow: TextOverflow.elide;
                            }

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #334155;
                                background: tile_copy_touch.has-hover ? #3b4252 : #262930;

                                tile_copy_touch := TouchArea {
                                    clicked => { copy-to-clipboard(tile.file_path); }
                                }

                                Rectangle {
                                    x: 4px;
                                    y: 4px;
                                    width: 16px;
                                    height: 16px;
                                    border-width: 1.5px;
                                    border-color: tile_copy_touch.has-hover ? #ffffff : #94a3b8;
                                }

                                Rectangle {
                                    x: 8px;
                                    y: 8px;
                                    width: 16px;
                                    height: 16px;
                                    border-width: 1.5px;
                                    border-color: tile_copy_touch.has-hover ? #ffffff : #94a3b8;
                                }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            min-height: 36px;
            padding: 4px;
            spacing: 6px;

            Button {
                text: @tr("Copy all list");
                clicked => { copy-all-to-clipboard(); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Rectangle {
                min-width: 210px;
                preferred-width: 210px;
                preferred-height: 32px;
                border-radius: 4px;
                background: (!root.can_delete_selected) ? #262626 : (delete_touch.pressed ? #b91c1c : (delete_touch.has-hover ? #dc2626 : #b91c1c));

                delete_touch := TouchArea {
                    enabled: root.can_delete_selected;
                    clicked => {
                        if (root.can_delete_selected) {
                            root.delete-from-route(selected-asset);
                        }
                    }
                }

                Text {
                    text: @tr("Delete from route");
                    color: (!root.can_delete_selected) ? #666666 : #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.can-repair-all: Rectangle {
                min-width: 210px;
                preferred-width: 210px;
                preferred-height: 32px;
                border-radius: 4px;
                background: repair_all_touch.pressed ? #047857 : (repair_all_touch.has-hover ? #10b981 : #059669);

                repair_all_touch := TouchArea {
                    enabled: root.can-repair-all;
                    clicked => { repair-all-corrupted(); }
                }

                Text {
                    text: @tr("Fix all broken paths");
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                min-width: 140px;
                preferred-width: 140px;
                preferred-height: 32px;
                border-radius: 4px;
                background: (!root.has_selection || !root.is_selected_asset_replaceable) ? #262626 : (replace_touch.pressed ? #047857 : (replace_touch.has-hover ? #10b981 : #059669));

                replace_touch := TouchArea {
                    enabled: root.has_selection && root.is_selected_asset_replaceable;
                    clicked => {
                        if (root.has_selection && root.is_selected_asset_replaceable) {
                            replace-missing(selected-asset);
                        }
                    }
                }

                Text {
                    text: @tr("Replace");
                    color: (!root.has_selection || !root.is_selected_asset_replaceable) ? #666666 : #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component RoutePropertiesWarningWindow inherits Window {
    title: @tr("RouteProperties.xml warning");
    min-width: 600px;
    min-height: 300px;

    in property <[string]> warnings: [];
    callback close-warning();

    VerticalBox {
        padding: 6px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: @tr("Providers/products not declared in RouteProperties.xml");
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                background: #3b1d24;
                border-radius: 4px;
                min-width: 32px;
                height: 22px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;

                    Text {
                        text: warnings.length;
                        color: #fbbf24;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        Rectangle {
            vertical-stretch: 1;

            ListView {
                for warning[i] in warnings: Rectangle {
                    background: row_touch.has-hover ? #222326 : transparent;
                    border-radius: 3px;

                    row_touch := TouchArea {
                        clicked => {}
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Text {
                            text: warning;
                            font-size: 12px;
                            color: #e2e8f0;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: @tr("Close");
                clicked => { root.close-warning(); }
            }
        }
    }
}

export component ApAssetPickerWindow inherits Window {
    title: @tr("Asset selection from archive");
    min-width: 620px;
    min-height: 420px;

    in property <string> archive-name: "";
    in-out property <string> search-query: "";
    in property <[string]> entries: [];
    in property <[string]> filtered-entries: [];
    in-out property <int> selected-index: -1;
    in-out property <bool> extracting: false;

    callback search-changed(string);
    callback select-entry(int);
    callback confirm-selection();
    callback cancel();

    VerticalBox {
        padding: 6px;
        spacing: 6px;

        Text {
            text: @tr("Asset selection from archive: {}", archive-name);
            font-size: 16px;
            font-weight: 700;
        }

        LineEdit {
            placeholder-text: @tr("Search");
            text <=> search-query;
            edited => { search-changed(search-query); }
        }

        Rectangle {
            background: #181818;
            border-color: #333333;
            border-width: 1px;
            border-radius: 4px;
            clip: true;
            vertical-stretch: 1;

            ListView {
                for entry[i] in filtered-entries: Rectangle {
                    background: i == selected-index ? #2c2d30 : (row_touch.has-hover ? #222326 : transparent);

                    row_touch := TouchArea {
                        clicked => { select-entry(i); }
                        double-clicked => { select-entry(i); confirm-selection(); }

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 6px;

                            Text {
                                text: entry;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            min-height: 36px;
            padding: 4px;
            spacing: 6px;

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.extracting: Text {
                text: @tr("Extracting...");
                color: #fbbf24;
                font-size: 12px;
                vertical-alignment: center;
            }
            Button {
                text: @tr("Cancel");
                enabled: !root.extracting;
                clicked => { cancel(); }
            }

            Rectangle {
                min-width: 100px;
                preferred-width: 120px;
                preferred-height: 32px;
                border-radius: 4px;
                background: pick_touch.pressed ? #047857 : (pick_touch.has-hover ? #10b981 : #059669);

                pick_touch := TouchArea {
                    enabled: !root.extracting;
                    clicked => { confirm-selection(); }
                }

                Text {
                    text: @tr("Select");
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: @tr("Settings");
    min-width: 400px;
    min-height: 230px;

    in-out property <int> serz-process-limit: 8;
    in property <int> serz-process-limit-max: 16;
    in property <[string]> serz-presets: [];
    in-out property <int> serz-process-limit-index: 0;
    in-out property <string> locoswap-path: "";
    in-out property <string> game-path: "";
    max-height: 230px;
    max-width: 400px;
    preferred-height: 230px;
    preferred-width: 400px;
    in-out property <bool> route-thumbnails-enabled: true;
    in-out property <bool> route-scan-on-hdd: false;
    in-out property <bool> hide-quick-drive-free-roam: false;
    in-out property <[string]> language-options: ["ru", "en", "de"];
    in-out property <int> language-index: 0;

    callback save-settings();
    callback settings-changed();
    callback pick-locoswap();
    callback pick-game();
    callback serz-preset-selected(int);
    callback language-selected(string);

    VerticalBox {
        HorizontalBox {
            alignment: LayoutAlignment.start;
            cross-axis-alignment: CrossAxisAlignment.center;
            padding: 0px;

            Text {
                min-width: 0px;
                overflow: TextOverflow.elide;
                text: @tr("CPU threads:");
                vertical-alignment: TextVerticalAlignment.center;
            }

            ComboBox {
                width: 100px;
                model: serz-presets;
                current-index <=> serz-process-limit-index;
                selected(text) => {
                    root.serz-preset-selected(self.current-index)
                }
            }
        }

        HorizontalBox {
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.center;
            min-height: 20px;
            padding: 0px;
            spacing: 8px;

            Text {
                line-height-factor: 0;
                min-height: 20px;
                overflow: TextOverflow.elide;
                text: @tr("LocoSwap path:");
                vertical-alignment: TextVerticalAlignment.center;
                wrap: TextWrap.word-wrap;
            }

            LineEdit {
                font-family: "";
                font-italic: false;
                font-size: 0px;
                horizontal-alignment: TextHorizontalAlignment.left;
                min-height: 20px;
                text <=> locoswap-path;
                edited(text) => { root.settings-changed(); }
            }

            Button {
                icon-size: 15px;
                min-height: 20px;
                text: @tr("Review");
                clicked => { pick-locoswap(); }
            }
        }

        HorizontalBox {
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.center;
            min-height: 20px;
            padding: 0px;
            spacing: 8px;

            Text {
                line-height-factor: 0;
                min-height: 20px;
                overflow: TextOverflow.elide;
                text: @tr("Game root folder:");
                vertical-alignment: TextVerticalAlignment.center;
                wrap: TextWrap.word-wrap;
            }

            LineEdit {
                font-family: "";
                font-italic: false;
                font-size: 0px;
                horizontal-alignment: TextHorizontalAlignment.left;
                min-height: 20px;
                text <=> game-path;
                edited(text) => { root.settings-changed(); }
            }

            Button {
                icon-size: 15px;
                min-height: 20px;
                text: @tr("Review");
                clicked => { pick-game(); }
            }
        }

        CheckBox {
            min-height: 20px;
            text: @tr("Route icons");
            checked <=> route-thumbnails-enabled;
            toggled => { root.settings-changed(); }
        }

        CheckBox {
            min-height: 20px;
            text: @tr("Game installed on HDD");
            checked <=> route-scan-on-hdd;
            toggled => { root.settings-changed(); }
        }

        CheckBox {
            min-height: 20px;
            text: @tr("Hide Quick-Drive and Free-Roam scenario types");
            checked <=> hide-quick-drive-free-roam;
            toggled => { root.settings-changed(); }
        }

        HorizontalBox {
            alignment: LayoutAlignment.start;
            cross-axis-alignment: CrossAxisAlignment.center;
            padding: 0px;

            Text {
                min-width: 0px;
                overflow: TextOverflow.elide;
                text: @tr("UI Language:");
                vertical-alignment: TextVerticalAlignment.center;
            }

            ComboBox {
                width: 100px;
                model: language-options;
                current-index <=> language-index;
                selected(text) => {
                    root.language-selected(text)
                }
            }
        }
    }
}

component FilterBadge inherits Rectangle {
    in property <int> count: 0;
    in property <bool> is_active: false;

    background: is_active ? #047857 : #374151;
    border-radius: 9px;
    height: 18px;
    min-width: 18px;
    horizontal-stretch: 0;

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        alignment: center;

        Text {
            text: root.count;
            font-size: 11px;
            font-weight: 600;
            color: #f3f4f6;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component FilterTabButton inherits Rectangle {
    in property <string> text;
    in property <int> count: 0;
    in property <bool> active: false;
    callback clicked();

    background: active ? #10b981 : #252932;
    border-radius: 6px;
    height: 32px;
    horizontal-stretch: 1;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? #ffffff : #d1d5db;
            vertical-alignment: center;
        }

        FilterBadge {
            count: root.count;
            is_active: root.active;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component ColumnSplitter inherits Rectangle {
    callback moved(length);
    width: 8px;

    Rectangle {
        x: 3px;
        width: 2px;
        background: #2e3440;
    }

    TouchArea {
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.moved(self.mouse-x - self.pressed-x);
            }
        }
    }
}

export component FolderAuditorWindow inherits Window {
    title: @tr("Asset folder check");
    min-width: 900px;
    min-height: 620px;

    in-out property <string> folder-path: "";
    in-out property <string> current-filter: "all";
    in-out property <int> selected-row-index: -1;

    in-out property <bool> is-selected-texture: false;
    in-out property <bool> has-missing-file-selected: false;
    in-out property <string> incoming-refs-preview: "";
    in-out property <string> outgoing-refs-preview: "";

    in-out property <length> col-kind-width: 140px;
    in-out property <length> col-missing-width: 380px;
    in-out property <int> sort-col: 2;
    in-out property <bool> sort-ascending: true;
    in property <float> scan-progress: 0.0;
    in property <string> scan-status-text: @tr("Ready for check");
    in-out property <bool> is-scanning: false;
    in-out property <bool> is-scan-completed: false;
    in property <string> editor-status: "";
    in property <[BrokenResourceItem]> filtered-rows: [];

    in-out property <int> count-all: 0;
    in-out property <int> count-geometry: 0;
    in-out property <int> count-textures: 0;
    in-out property <int> count-scripts: 0;
    in-out property <int> count-sounds: 0;
    in-out property <int> count-children: 0;
    in-out property <int> count-dead: 0;

    callback pick-folder();
    callback start-audit(string);
    callback filter-changed(string);
    callback row-selected(int);
    callback open-source-file(int);
    callback open-missing-target-folder(int);
    callback edit-in-vscode(int);
    callback preview-texture(int);
    callback sort-column(int);
    callback show-graph-clicked();
    callback open-full-graph();
    callback open-global-graph();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        HorizontalBox {
            spacing: 8px;

            path_input := LineEdit {
                horizontal-stretch: 1;
                text <=> folder-path;
                placeholder-text: @tr("Folder to check...");
                enabled: !root.is-scanning;
            }

            Button {
                text: @tr("Review");
                enabled: !root.is-scanning;
                clicked => { root.pick-folder(); }
            }

            Button {
                text: root.is-scanning ? @tr("Checking...") : @tr("Start check");
                primary: true;
                enabled: !root.is-scanning && path_input.text != "";
                clicked => { root.start-audit(root.folder-path); }
            }
        }

        VerticalBox {
            spacing: 4px;
            padding: 0px;
            vertical-stretch: 0;
            if root.is-scanning: Rectangle {
                height: 4px;
                background: #333333;

                Rectangle {
                    x: 0px;
                    width: max(0px, root.scan-progress * parent.width);
                    height: 100%;
                    background: #3b82f6;
                }
            }
            Text {
                text: root.scan-status-text;
                font-size: 12px;
                color: root.is-scanning ? #60a5fa : #9ca3af;
            }
        }

        if !root.is-scanning && root.is-scan-completed: HorizontalBox {
            spacing: 6px;
            padding: 0px;
            vertical-stretch: 0;

            if root.count-all > 0: HorizontalLayout {
                spacing: 6px;

                FilterTabButton {
                    text: @tr("All");
                    count: root.count-all;
                    active: root.current-filter == "all";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "all";
                        root.filter-changed("all");
                    }
                }

                if root.count-geometry > 0: FilterTabButton {
                    text: @tr("Geometry");
                    count: root.count-geometry;
                    active: root.current-filter == "geometry";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "geometry";
                        root.filter-changed("geometry");
                    }
                }

                if root.count-textures > 0: FilterTabButton {
                    text: @tr("Textures");
                    count: root.count-textures;
                    active: root.current-filter == "texture";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "texture";
                        root.filter-changed("texture");
                    }
                }

                if root.count-scripts > 0: FilterTabButton {
                    text: @tr("Scripts");
                    count: root.count-scripts;
                    active: root.current-filter == "script";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "script";
                        root.filter-changed("script");
                    }
                }

                if root.count-sounds > 0: FilterTabButton {
                    text: @tr("Sounds");
                    count: root.count-sounds;
                    active: root.current-filter == "sound";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "sound";
                        root.filter-changed("sound");
                    }
                }

                if root.count-children > 0: FilterTabButton {
                    text: @tr("Child objects");
                    count: root.count-children;
                    active: root.current-filter == "child";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "child";
                        root.filter-changed("child");
                    }
                }

                if root.count-dead > 0: FilterTabButton {
                    text: @tr("Unused");
                    count: root.count-dead;
                    active: root.current-filter == "orphans";
                    clicked => {
                        root.selected-row-index = -1;
                        root.current-filter = "orphans";
                        root.filter-changed("orphans");
                    }
                }
            }

            if root.count-all == 0: Rectangle {
                width: 8px;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Button {
                    text: @tr("Full graph");
                    enabled: !root.is-scanning && root.is-scan-completed;
                    clicked => { root.open-full-graph(); }
                    min-width: 170px;
                    preferred-height: 32px;
                }
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;

            Text {
                text: sort-col == 0 ? (sort-ascending ? @tr("Type ↑") : @tr("Type ↓")) : @tr("Type");
                width: root.col-kind-width;
                horizontal-alignment: left;
                vertical-alignment: center;
                color: #9ca3af;
                font-size: 12px;

                TouchArea {
                    clicked => { root.sort-column(0); }
                }
            }

            ColumnSplitter {
                moved(delta) => {
                    root.col-kind-width = max(80px, root.col-kind-width + delta);
                }
            }

            if root.current-filter != "orphans": HorizontalLayout {
                spacing: 0px;

                Text {
                    text: sort-col == 1 ? (sort-ascending ? @tr("Missing file ↑") : @tr("Missing file ↓")) : @tr("Missing file");
                    width: root.col-missing-width;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    color: #9ca3af;
                    font-size: 12px;

                    TouchArea {
                        clicked => { root.sort-column(1); }
                    }
                }

                ColumnSplitter {
                    moved(delta) => {
                        root.col-missing-width = max(120px, root.col-missing-width + delta);
                    }
                }
            }

            Text {
                text: root.current-filter == "orphans" ? (sort-col == 2 ? (sort-ascending ? @tr("Unused file ↑") : @tr("Unused file ↓")) : @tr("Unused file")) : (sort-col == 2 ? (sort-ascending ? @tr("Source file ↑") : @tr("Source file ↓")) : @tr("Source file"));
                horizontal-alignment: left;
                vertical-alignment: center;
                horizontal-stretch: 1;
                color: #9ca3af;
                font-size: 12px;

                TouchArea {
                    clicked => { root.sort-column(2); }
                }
            }
        }

        Rectangle {
            background: #181b20;
            border-radius: 6px;
            border-width: 1px;
            border-color: #282c34;
            vertical-stretch: 1;

            if root.filtered-rows.length == 0: VerticalBox {
                alignment: center;

                Text {
                    text: @tr("No problems found");
                    color: #6b7280;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }

            ListView {
                for item[idx] in root.filtered-rows: Rectangle {
                    background: idx == root.selected-row-index ? #2b313c : (Math.mod(idx, 2) == 0 ? #181b20 : #1c2026);
                    height: 28px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 0px;

                        Text {
                            text: item.kind_str;
                            width: root.col-kind-width;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            color: item.is_dead ? #eab308 : #ef4444;
                            overflow: elide;
                        }

                        Rectangle {
                            width: 8px;
                        }

                        if root.current-filter != "orphans": HorizontalLayout {
                            spacing: 0px;

                            Text {
                                text: item.expected_path;
                                width: root.col-missing-width;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                color: #f3f4f6;
                                overflow: elide;
                            }

                            Rectangle {
                                width: 8px;
                            }
                        }

                        Text {
                            text: item.parent_file;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: item.is_dead ? #f3f4f6 : #9ca3af;
                            overflow: elide;
                        }
                    }

                    TouchArea {
                        clicked => { root.selected-row-index = idx; root.row-selected(idx); }
                    }
                }
            }
        }

        if root.selected-row-index >= 0: VerticalBox {
            padding: 0px;
            spacing: 8px;

            HorizontalBox {
                padding: 0px;
                spacing: 16px;

                Text {
                    text: @tr("Incoming links: ") + root.incoming-refs-preview;
                    font-size: 11px;
                    color: #9ca3af;
                    overflow: elide;
                }

                Text {
                    text: @tr("Outgoing links: ") + root.outgoing-refs-preview;
                    font-size: 11px;
                    color: #9ca3af;
                    overflow: elide;
                }
            }

            HorizontalBox {
                padding: 0px;
                spacing: 8px;

                Button {
                    text: @tr("Open folder of source file");
                    enabled: !root.is-scanning;
                    clicked => { root.open-source-file(root.selected-row-index); }
                }

                Button {
                    text: @tr("Open source file");
                    enabled: !root.is-scanning;
                    clicked => { root.edit-in-vscode(root.selected-row-index); }
                }

                if root.has-missing-file-selected: Button {
                    text: @tr("Open folder of missing file");
                    enabled: !root.is-scanning;
                    clicked => { root.open-missing-target-folder(root.selected-row-index); }
                }
                if root.is-selected-texture: Button {
                    text: @tr("View texture");
                    enabled: !root.is-scanning;
                    clicked => { root.preview-texture(root.selected-row-index); }
                }
                Button {
                    text: @tr("Dependency graph");
                    enabled: !root.is-scanning;
                    clicked => { root.show-graph-clicked(); }
                }
            }
        }

        Text {
            text: root.editor-status;
            color: #a1a1aa;
            font-size: 12px;
        }
    }
}
