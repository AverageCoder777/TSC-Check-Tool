import { VerticalBox, Button } from "std-widgets.slint";

export component TextureViewerWindow inherits Window {
    title: @tr("Просмотр текстур");
    in-out property <image> texture-image;
    in-out property <int> texture-orig-width: 0;
    in-out property <int> texture-orig-height: 0;
    in-out property <float> zoom-factor: 1.0;
    in-out property <string> info-text: "";
    in-out property <bool> show-alpha: true;

    callback toggle-alpha();
    callback export-dds();
    callback replace-from-dds();

    VerticalBox {
        Text { text: info-text; }
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            TouchArea {
                scroll-event(event) => {
                    if (event.delta-y > 0) {
                        root.zoom_factor = Math.min(8.0, root.zoom_factor * 1.15);
                    } else if (event.delta-y < 0) {
                        root.zoom_factor = Math.max(0.1, root.zoom_factor / 1.15);
                    }
                    accept
                }
            }
            Image {
                source: texture-image;
                width: texture-orig-width * zoom-factor * 1px;
                height: texture-orig-height * zoom-factor * 1px;
            }
        }
        Button { text: @tr("Переключить альфа-канал"); clicked => { toggle-alpha(); } }
        Button { text: @tr("Экспортировать DDS"); clicked => { export-dds(); } }
        Button { text: @tr("Заменить из DDS"); clicked => { replace-from-dds(); } }
    }
}
